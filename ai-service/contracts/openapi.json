                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/v1/generations/{ai_job_id}/events": {
      "get": {
        "summary": "Stream Events",
        "operationId": "stream_events_internal_ai_v1_generations__ai_job_id__events_get",
        "parameters": [
          {
            "name": "ai_job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ai Job Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Alternative to the Last-Event-ID header",
              "title": "After"
            },
            "description": "Alternative to the Last-Event-ID header"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "accepted / delta / completed / failed",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/v1/lifecycle-events": {
      "post": {
        "summary": "Post Lifecycle Event",
        "description": "202 means \"stored in the Inbox\", not \"applied\".",
        "operationId": "post_lifecycle_event_internal_ai_v1_lifecycle_events_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ConversationOpened"
                  },
                  {
                    "$ref": "#/components/schemas/AnswerCommitted"
                  },
                  {
                    "$ref": "#/components/schemas/CharacterRevisionChanged"
                  },
                  {
                    "$ref": "#/components/schemas/ConversationReset"
                  },
                  {
                    "$ref": "#/components/schemas/CharacterDeleted"
                  }
                ],
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "ConversationOpened": "#/components/schemas/ConversationOpened",
                    "AnswerCommitted": "#/components/schemas/AnswerCommitted",
                    "CharacterRevisionChanged": "#/components/schemas/CharacterRevisionChanged",
                    "ConversationReset": "#/components/schemas/ConversationReset",
                    "CharacterDeleted": "#/components/schemas/CharacterDeleted"
                  }
                },
                "title": "Event"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
