  "discriminator": {
    "mapping": {
      "AnswerCommitted": "#/$defs/AnswerCommitted",
      "CharacterDeleted": "#/$defs/CharacterDeleted",
      "CharacterRevisionChanged": "#/$defs/CharacterRevisionChanged",
      "ConversationOpened": "#/$defs/ConversationOpened",
      "ConversationReset": "#/$defs/ConversationReset"
