      "required": [
        "eventId",
        "tenantId",
        "ownerId",
        "aggregateType",
        "aggregateId",
        "aggregateSeq",
        "occurredAt",
        "type",
        "payload"
      ],
      "title": "AnswerCommitted",
      "type": "object"
