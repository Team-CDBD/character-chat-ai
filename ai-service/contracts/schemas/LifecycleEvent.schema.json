      "enum": [
        "CONVERSATION",
        "CHARACTER"
      ],
      "title": "AggregateType",
      "type": "string"
    },
    "AnswerCommitted": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "eventId": {
          "title": "Eventid",
          "type": "string"
        },
        "tenantId": {
          "title": "Tenantid",
          "type": "string"
        },
        "ownerId": {
          "title": "Ownerid",
          "type": "string"
        },
        "aggregateType": {
          "$ref": "#/$defs/AggregateType"
        },
        "aggregateId": {
          "title": "Aggregateid",
          "type": "string"
        },
        "aggregateSeq": {
          "minimum": 1,
          "title": "Aggregateseq",
          "type": "integer"
        },
        "occurredAt": {
          "format": "date-time",
          "title": "Occurredat",
          "type": "string"
        },
        "type": {
          "const": "AnswerCommitted",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AnswerCommittedPayload"
        }
