        "responseId": {
          "title": "Responseid",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "responseId",
        "text"
      ],
      "title": "AssistantMessage",
      "type": "object"
    },
    "CharacterCard": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 50,
          "title": "Name",
          "type": "string"
