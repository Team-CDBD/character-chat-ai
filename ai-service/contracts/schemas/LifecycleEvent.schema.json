    "AnswerCommittedPayload": {
      "additionalProperties": false,
      "properties": {
        "conversationId": {
          "title": "Conversationid",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "turnSeq": {
          "minimum": 1,
          "title": "Turnseq",
          "type": "integer"
        },
        "characterRevision": {
          "minimum": 1,
          "title": "Characterrevision",
          "type": "integer"
        },
        "userMessage": {
          "$ref": "#/$defs/ChatMessage"
        },
        "assistantMessage": {
          "$ref": "#/$defs/AssistantMessage"
        }
      },
      "required": [
        "conversationId",
        "epoch",
        "turnSeq",
        "characterRevision",
        "userMessage",
        "assistantMessage"
      ],
