{
  "$defs": {
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        },
        "sentAt": {
          "format": "date-time",
          "title": "Sentat",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "sentAt"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "GenerationMode": {
      "enum": [
        "NEW",
        "REGENERATE",
        "RETRY"
      ],
      "title": "GenerationMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "tenantId": {
      "title": "Tenantid",
      "type": "string"
    },
    "ownerId": {
      "title": "Ownerid",
      "type": "string"
    },
    "conversationId": {
      "title": "Conversationid",
      "type": "string"
    },
    "epoch": {
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "turnSeq": {
      "minimum": 1,
      "title": "Turnseq",
      "type": "integer"
    },
    "attemptId": {
      "title": "Attemptid",
      "type": "string"
    },
    "responseId": {
      "title": "Responseid",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/GenerationMode",
      "default": "NEW"
    },
    "requiredLifecycleSeq": {
      "minimum": 0,
      "title": "Requiredlifecycleseq",
      "type": "integer"
    },
    "baseCommittedTurnSeq": {
      "minimum": 0,
      "title": "Basecommittedturnseq",
      "type": "integer"
    },
    "characterRevision": {
      "minimum": 1,
      "title": "Characterrevision",
      "type": "integer"
    },
    "personaRevision": {
      "minimum": 0,
      "title": "Personarevision",
      "type": "integer"
    },
    "userMessage": {
      "$ref": "#/$defs/ChatMessage"
    },
    "contextSnapshotId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contextsnapshotid"
    },
    "timezone": {
      "default": "Asia/Seoul",
      "title": "Timezone",
      "type": "string"
    },
    "generationPolicyVersion": {
      "default": "chat-v1",
      "title": "Generationpolicyversion",
      "type": "string"
    },
    "deadlineAt": {
      "format": "date-time",
      "title": "Deadlineat",
      "type": "string"
    },
    "traceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceid"
    }
  },
  "required": [
    "tenantId",
    "ownerId",
    "conversationId",
    "epoch",
    "turnSeq",
    "attemptId",
    "responseId",
    "requiredLifecycleSeq",
    "baseCommittedTurnSeq",
    "characterRevision",
    "personaRevision",
    "userMessage",
    "deadlineAt"
  ],
  "title": "GenerationRequest",
  "type": "object"
}
